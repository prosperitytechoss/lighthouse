{
  "name": "@lighthouse/api",
  "version": "0.0.0",
  "private": true,
  "description": "Lighthouse backend API — Express + Drizzle + Postgres + Redis.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-lexicon": "tsx src/db/seed-lexicon.ts",
    "db:export-lexicon": "tsx src/db/export-lexicon.ts",
    "db:import-lexicon": "tsx src/db/import-lexicon.ts"
  },
  "dependencies": {
    "@lighthouse/types": "*",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "postgres": "^3.4.5",
    "redis": "^4.7.0",
    "resend": "^4.8.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@lighthouse/eslint-config": "*",
    "@lighthouse/tsconfig": "*",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "nodemon": "^3.1.9",
    "typescript": "~6.0.3"
  }
}

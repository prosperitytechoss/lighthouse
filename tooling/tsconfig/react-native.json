{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Lighthouse React Native (Expo)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true
  }
}
